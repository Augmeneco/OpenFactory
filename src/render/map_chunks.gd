class_name MapChunks
extends RefCounted
## Cached top-down pictures of the world, one 32x32 texture per chunk.
##
## The minimap and the full map both want the same thing: a tile-coloured
## picture of the ground with the ore over it.  Building that picture out of
## per-cell lookups is far too slow to repeat — the old minimap resolved 34,000
## cells every twenty frames (about 107 ms of stall) and the map window did
## hundreds of thousands while open.
##
## Here each chunk is rasterised once into a 32x32 image and kept as a texture.
## A chunk is rebuilt only when the world says its tile or ore data changed
## (``GameWorld.chunk_stamp``), so moving the view costs one or two chunk
## rebuilds, not a whole map.

const CHUNK := GameWorld.CHUNK
const SOURCE := CHUNK * CHUNK

var world: GameWorld
## When true the map may show only chunks already generated by the player or
## a radar; it never expands the world just by looking at it.
var require_generated := false
## When true the map is a satellite view: only explored/scanned chunks may show
## terrain; everything else is handled as noise by the map window.
var require_revealed := false

var _entries: Dictionary = {}        ## Vector2i -> {epoch, stamp, texture, image}
var _tile_colours: Dictionary = {}
var _ore_colours: Dictionary = {}
var _default_colour := Color(0.35, 0.35, 0.35)


func _init(world_: GameWorld) -> void:
	world = world_
	_build_colours()


## Map colours from the prototypes: tiles store 0-255 bytes, resources 0-1.
func _build_colours() -> void:
	for name: String in Prototypes.all("tile"):
		var raw: Variant = Prototypes.get_p("tile", name).get("map_color")
		if raw != null:
			_tile_colours[name] = _to_colour(raw, true)
	for name: String in Prototypes.all("resource"):
		var raw: Variant = Prototypes.get_p("resource", name).get("map_color")
		if raw != null:
			_ore_colours[name] = _to_colour(raw, false)


static func _to_colour(raw: Variant, bytes: bool) -> Color:
	if raw is Array and (raw as Array).size() >= 3:
		var values: Array = raw
		if bytes:
			return Color(float(values[0]) / 255.0, float(values[1]) / 255.0,
				float(values[2]) / 255.0)
		return Color(float(values[0]), float(values[1]), float(values[2]))
	if raw is String:
		return Color(raw)
	return Color(0.35, 0.35, 0.35)


## The texture for a chunk, rebuilt only when its stamp changed.
##
## ``generate`` controls whether asking for a chunk may create it.  The minimap
## follows the player and wants the ground around them; the full map must not
## generate the entire view, or opening it would stall for a second while it
## creates hundreds of chunks.  Ungenerated chunks simply stay dark.
func texture_for(coord: Vector2i, generate := true,
		with_ore := true) -> Texture2D:
	if world == null:
		return null
	if require_revealed and not world.is_chunk_revealed(coord):
		return null
	if require_generated or not generate:
		if not world.is_generated(coord):
			return null
	# The ore flag is part of the key: the minimap always has ore on while the
	# map can hide it, and both can share one cache without fighting.
	var key := _key(coord, with_ore)
	var entry: Variant = _entries.get(key)
	if entry != null and int((entry as Dictionary)["epoch"]) == world.epoch \
			and int((entry as Dictionary)["stamp"]) == world.chunk_stamp(coord):
		return (entry as Dictionary)["texture"]
	var image := build_image(coord, with_ore)
	var texture: ImageTexture
	if entry != null:
		texture = (entry as Dictionary)["texture"]
		texture.update(image)
	else:
		texture = ImageTexture.create_from_image(image)
	_entries[key] = {
		"epoch": world.epoch,
		"stamp": world.chunk_stamp(coord),
		"show_ore": with_ore,
		"texture": texture,
		"image": image,
	}
	if _entries.size() > 4096:
		# Plenty for a long journey; the next view simply warms up again.
		_entries.clear()
	return texture


func image_for(coord: Vector2i, generate := true,
		with_ore := true) -> Image:
	texture_for(coord, generate, with_ore)
	var entry: Variant = _entries.get(_key(coord, with_ore))
	if entry == null:
		return null
	# A map that does not generate chunks must not fall back to a picture of
	# the previous world after a load or a new game.
	if int((entry as Dictionary)["epoch"]) != world.epoch:
		return null
	return (entry as Dictionary)["image"]


static func _key(coord: Vector2i, with_ore: bool) -> String:
	return "%d,%d,%s" % [coord.x, coord.y, "ore" if with_ore else "bare"]


## Rasterise one chunk.  Public so a tool can ask for the picture directly.
func build_image(coord: Vector2i, with_ore := true) -> Image:
	# Generating the chunk bumps its stamp, so do it before the timestamp is
	# stored by the caller.
	world.chunk(coord)
	var base := coord * CHUNK
	var packed := PackedByteArray()
	packed.resize(SOURCE * 4)
	for y in CHUNK:
		for x in CHUNK:
			var cell := base + Vector2i(x, y)
			var colour := _tile_colour(world.tile_at(cell))
			var ore_name := ""
			var ore_amount := 0.0
			if with_ore:
				var ore := world.ore_at(cell)
				ore_name = str(ore["name"])
				ore_amount = float(ore["amount"])
			if not ore_name.is_empty() and ore_amount > 0.0:
				var ore_colour: Variant = _ore_colours.get(ore_name)
				if ore_colour != null:
					colour = ore_colour
			var index := (y * CHUNK + x) * 4
			packed[index] = int(colour.r * 255.0)
			packed[index + 1] = int(colour.g * 255.0)
			packed[index + 2] = int(colour.b * 255.0)
			packed[index + 3] = 255
	return Image.create_from_data(CHUNK, CHUNK, false, Image.FORMAT_RGBA8, packed)


func _tile_colour(tile: String) -> Color:
	var colour: Variant = _tile_colours.get(tile)
	if colour != null:
		return colour
	# Tile names are like "grass-1"; fall back to the base name.
	var dash := tile.rfind("-")
	if dash > 0:
		var stripped := tile.substr(0, dash)
		if _tile_colours.has(stripped):
			return _tile_colours[stripped]
	return _default_colour


## Forget everything, for a new game or a load.
func clear() -> void:
	_entries.clear()


func stats() -> Dictionary:
	return {"chunks": _entries.size(), "tiles": _tile_colours.size(),
		"ores": _ore_colours.size()}
